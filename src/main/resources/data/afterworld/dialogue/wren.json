  "ladder": {
   "lines": [
    {
     "text": "The Warden's Ladder. An old gate, dark stone, a stone that glows. Step through and you're somewhere else entirely.",
     "sound": "afterworld:va.wren.ladder_0",
     "ticks": 206,
     "cue": "lowers voice",
     "beats": [
      90,
      940,
      2360,
      3210,
      4140,
      5120,
      5970,
      7240,
      8130,
      8980,
      9830
     ]
    },
    {
     "text": "Fifty floors, they say, each one meaner than the last. The Guild has never mapped past the fifth. I've marked the nearest gate for you!",
     "sound": "afterworld:va.wren.ladder_1",
     "ticks": 180,
     "cue": "brightly",
     "beats": [
      30,
      770,
      1500,
      2550,
      3280,
      4470,
      5200,
      5980,
      7010,
      7750,
      8480
     ]
    }
