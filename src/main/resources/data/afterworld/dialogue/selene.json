  "stars_assemble": {
   "lines": [
    {
     "text": "You found them. All three. Let me... yes. There. The Lost Moth.",
     "sound": "afterworld:va.selene.stars_assemble_0",
     "ticks": 156,
     "cue": "breathless",
     "beats": [
      10,
      630,
