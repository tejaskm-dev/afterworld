  "prices": {
   "lines": [
    {
     "text": "Every merchant pays more for what's scarce where they stand. Ember glass is cheap where it's made, and dear in the snow.",
     "sound": "afterworld:va.bram.prices_0",
     "ticks": 148,
     "beats": [
      20,
      640,
      1260,
      1880,
      2540,
      3180,
      4220,
      4910,
      5540,
      6350,
      6970
     ]
    },
    {
     "text": "Carry goods between the keepers and you'll make a fortune. Or lose your boots to a lurker. That's trade.",
     "sound": "afterworld:va.bram.prices_1",
     "ticks": 147,
     "cue": "chuckles",
     "beats": [
      20,
      620,
      1230,
      1970,
      2570,
      3550,
      4150,
      4750,
      5600,
      6280,
      6870
     ]
    },
    {
     "text": "And don't sell all your fangs to one stall in one day. I'll stop wanting them. So will everyone.",
     "sound": "afterworld:va.bram.prices_2",
     "ticks": 126,
     "beats": [
      30,
      550,
      1070,
      1590,
      2110,
      2630,
      3150,
      3960,
      4480,
      5360,
      5880
