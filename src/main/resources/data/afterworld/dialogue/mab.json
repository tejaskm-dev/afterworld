   ],
   "options": [
    {
     "text": "I'll fetch them.",
     "go": "#end",
     "do": [
      "side:brew:start"
     ]
    },
    {
     "text": "Not now.",
     "go": "#end"
    }
   ]
  },
  "brew_progress": {
   "lines": [
    {
     "text": "Fangs, amber, dust. I'll not repeat myself a third time. I will, actually. Fangs. Amber. Dust.",
