 "nodes": {
  "meet": {
   "lines": [
    {
     "text": "Welcome to the Hourglass, friend. Rashid, master of this caravan. The water is free. Everything else, we can discuss.",
     "sound": "afterworld:va.rashid.meet_0",
     "ticks": 181,
     "cue": "playful",
     "beats": [
      30,
      750,
      1460,
      2600,
      3570,
      4280,
      5400,
      6520,
      7230,
      7990,
      8700
     ]
    }
   ],
   "options": [
    {
     "text": "What is the obelisk for?",
     "go": "obelisk"
    },
    {
     "text": "You look worried.",
     "go": "caravan_offer",
     "if": [
      "!side:caravan:started"
     ]
    },
    {
     "text": "Let's discuss.",
     "go": "#shop"
    },
    {
     "text": "Farewell.",
     "go": "#end"
    }
   ]
  },
  "greet": {
   "lines": [
    {
