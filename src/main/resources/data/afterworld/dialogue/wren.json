   "options": [
    {
     "text": "Mark something else.",
     "go": "marks"
    },
    {
     "text": "Thanks, Wren.",
     "go": "#end"
    }
   ]
  },
  "marked": {
   "lines": [
    {
     "text": "There. It's on your map now. Follow the light, and mind the edges. The edges are where maps get hungry.",
