     "ticks": 190,
     "cue": "booming",
     "beats": [
      20,
      800,
      1850,
      2620,
      3400,
      4190,
      5270,
      6050,
      7440,
      8220,
      9090
     ]
    },
    {
     "text": "She's moored for repairs. Bring me gear springs and clockwork, and I'll make it worth your while.",
     "sound": "afterworld:va.odo.meet_1",
     "ticks": 107,
     "beats": [
      20,
      470,
      920,
      1780,
      2230,
      2690,
      3140,
      3590,
      4040,
      4490,
      4930
     ]
    }
   ],
   "options": [
    {
     "text": "Tell me about the sky.",
     "go": "sky"
    },
    {
     "text": "What needs fixing?",
     "go": "wayfarer_offer",
     "if": [
      "!side:wayfarer:started"
     ]
    },
    {
     "text": "Let's trade.",
     "go": "#shop"
    },
    {
     "text": "Farewell.",
     "go": "#end"
    }
   ]
  },
  "greet": {
   "lines": [
    {
