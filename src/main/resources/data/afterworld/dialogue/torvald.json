 "nodes": {
  "meet": {
   "lines": [
    {
     "text": "Stranger. Sit by the fire if you like. Torvald. I hunt what hunts the valley.",
     "sound": "afterworld:va.torvald.meet_0",
     "ticks": 135,
     "beats": [
      0,
      510,
      1370,
      1880,
      2390,
      3420,
      3930,
      4810,
      5320,
      5830,
      6380
     ]
    },
    {
     "text": "The rimehorns are restless this year. And something walks the frozen peaks. Taller than the trees.",
     "sound": "afterworld:va.torvald.meet_1",
     "ticks": 154,
     "beats": [
      20,
      600,
      1180,
      1760,
      2870,
      3440,
      4020,
      4620,
      6090,
      6670,
      7240
     ]
    }
   ],
   "options": [
    {
     "text": "Something taller than trees?",
     "go": "big"
    },
    {
     "text": "Need a hunter?",
     "go": "hunt_offer",
     "if": [
      "!side:hunt:started"
     ]
    },
    {
     "text": "Can we trade?",
     "go": "#shop"
    },
    {
     "text": "Farewell.",
     "go": "#end"
    }
   ]
  },
  "greet": {
   "lines": [
    {
     "text": "The fire's warm. The meat's fresh. Sit.",
