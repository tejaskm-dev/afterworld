  "find_three": {
   "lines": [
    {
     "text": "The cathedral lies south and west, under a bell nobody remembers hearing. The vault goes down a long way, past the old roads.",
     "sound": "afterworld:va.isolde.find_three_0",
     "ticks": 174,
     "beats": [
      20,
      740,
      1460,
      2370,
      3090,
