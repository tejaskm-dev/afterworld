 "nodes": {
  "meet": {
   "lines": [
    {
     "text": "Heh. Another one wading in. I'm Mab. The fen is mine, and I'm the fen's.",
     "sound": "afterworld:va.mab.meet_0",
     "ticks": 185,
     "cue": "cackles",
     "beats": [
      0,
      730,
      1880,
      2620,
      3350,
      4570,
      5310,
      6440,
      7310,
      8040,
      8870
     ]
    },
    {
     "text": "Mind the lurkers. They look like logs, right up until they don't.",
     "sound": "afterworld:va.mab.meet_1",
     "ticks": 103,
     "beats": [
      30,
      440,
      850,
      1380,
      1860,
      2260,
      2700,
      3320,
      3750,
      4170,
      4670
     ]
    }
   ],
   "options": [
    {
     "text": "Any advice?",
     "go": "advice"
    },
    {
     "text": "I'd like to cross the water dry.",
     "go": "brew_offer",
     "if": [
      "!side:brew:started"
     ]
    },
    {
     "text": "What are you brewing?",
     "go": "#shop"
    },
    {
     "text": "Farewell.",
     "go": "#end"
    }
   ]
  },
