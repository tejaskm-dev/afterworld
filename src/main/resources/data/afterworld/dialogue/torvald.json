      1970,
      2310,
      2640,
      2980,
      3310,
      3640
     ]
    },
    {
     "text": "Every hunter at this lodge has shot the targets. Hit six of eight, and I'll call you hunter too.",
     "sound": "afterworld:va.torvald.hunt_killed_1",
     "ticks": 120,
     "beats": [
