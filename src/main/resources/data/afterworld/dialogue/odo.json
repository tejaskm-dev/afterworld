     ]
    },
    {
     "text": "Not now.",
     "go": "#end"
    }
   ]
  },
  "wayfarer_progress": {
   "lines": [
    {
     "text": "Six springs and two fragments, groundling. The sky won't wait forever. Actually, it will. But I won't.",
