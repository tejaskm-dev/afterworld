  "first": {
   "lines": [
    {
     "text": "First things first. Lay your hand on the waystone, there on the dais. Once it knows you, it will always bring you home.",
     "sound": "afterworld:va.isolde.first_0",
     "ticks": 187,
     "beats": [
      0,
      680,
      2040,
      2710,
      3400,
      4210,
      5780,
      6460,
      7480,
      8210,
      8880
     ]
    },
    {
     "text": "Then let out the Edict that lives in you, and go and see Marta at the forge. She'll teach you how not to die. Mostly.",
     "sound": "afterworld:va.isolde.first_1",
     "ticks": 222,
     "cue": "dryly",
     "beats": [
      20,
      1020,
      1930,
      2750,
      3580,
      4720,
      5550,
      7090,
      7910,
      8740,
