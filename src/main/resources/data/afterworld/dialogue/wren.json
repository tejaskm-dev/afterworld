 "nodes": {
  "meet": {
   "lines": [
    {
     "text": "Oh! A new face. Wren Halloway, Cartographers' Guild. I map the places that won't sit still.",
     "sound": "afterworld:va.wren.meet_0",
     "ticks": 149,
     "beats": [
      30,
      690,
      1310,
      2190,
      2810,
      3530,
      4150,
      5080,
      5700,
      6320,
      6940
     ]
    },
    {
     "text": "If you're looking for something out there, I can probably mark it on your map. Probably. And I keep the Guild Ledger, so your Marks can sleep somewhere safer than your pockets.",
     "sound": "afterworld:va.wren.meet_1",
     "ticks": 216,
     "beats": [
      50,
      920,
      2030,
      2950,
      4240,
      5450,
      6400,
      7500,
      8400,
      9270,
      10230
     ]
    }
   ],
   "options": [
    {
     "text": "Mark something for me.",
     "go": "marks"
    },
    {
     "text": "The Guild Ledger.",
     "go": "#bank"
    },
    {
     "text": "Tell me about the landmarks.",
     "go": "landmarks"
    },
    {
     "text": "What do you sell?",
     "go": "#shop"
    },
    {
     "text": "Farewell.",
     "go": "#end"
    }
   ]
  },
  "greet": {
   "lines": [
    {
     "text": "Back from the edges? Tell me everything. Or at least, tell me where.",
