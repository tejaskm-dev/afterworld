  "lore": {
   "lines": [
    {
     "text": "Light remembers. A fallen star is a memory the sky let go of.",
     "sound": "afterworld:va.selene.lore_0",
     "ticks": 129,
     "beats": [
      10,
      530,
      1040,
      1550,
      2090,
      2600,
      3120,
      3630,
      4140,
      4650,
      5250
     ]
    },
    {
     "text": "The Bureau keeps some of them in jars, I'm told. I hope they whisper to them. Stars get lonely.",
     "sound": "afterworld:va.selene.lore_1",
     "ticks": 156,
     "cue": "sadly",
