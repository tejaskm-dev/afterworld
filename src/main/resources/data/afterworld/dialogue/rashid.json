  "obelisk": {
   "lines": [
    {
     "text": "It tells the hours with its shadow. But at noon, sometimes, it tells the wrong one.",
     "sound": "afterworld:va.rashid.obelisk_0",
     "ticks": 123,
     "beats": [
      20,
      520,
      1010,
      1510,
      2000,
      3020,
      3620,
      4120,
      4670,
      5170,
      5670
     ]
    },
    {
     "text": "On those days the sand remembers things it shouldn't. We pack up early.",
     "sound": "afterworld:va.rashid.obelisk_1",
     "ticks": 106,
     "beats": [
      10,
      430,
      840,
