  "bell_offer": {
   "lines": [
    {
     "text": "Some nights a voice hums near the altar. A child's voice, I think. The bell-ringer's apprentice, who drowned with the bell.",
     "sound": "afterworld:va.ines.bell_offer_0",
     "ticks": 191,
     "beats": [
      20,
      760,
      1500,
      2240,
      3220,
      3960,
      4700,
      5830,
      6570,
      7330,
      8090
     ]
    },
    {
     "text": "The bell's rope was carried off by the tide. It lies in the drowned shrine on the coast, if the old records are right. Bring it back, and perhaps she can finish her song.",
     "sound": "afterworld:va.ines.bell_offer_1",
     "ticks": 235,
     "beats": [
