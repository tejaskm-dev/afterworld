 "nodes": {
  "meet": {
   "lines": [
    {
     "text": "Isolde sent you? Then you're welcome at my stall. Name's Bram. I keep this camp fed, lit and stitched together.",
     "sound": "afterworld:va.bram.meet_0",
     "ticks": 172,
     "beats": [
      20,
      730,
      1830,
      2540,
      3250,
      4290,
      5350,
      6060,
      6770,
      7490,
      8200
     ]
    },
    {
     "text": "Here's twenty-five Marks to start you off. Nobody walks out of my camp with an empty purse. That's not charity, mind. It's an investment.",
     "sound": "afterworld:va.bram.meet_1",
     "ticks": 175,
     "cue": "gruff",
     "beats": [
      10,
      750,
      1490,
      2590,
      3330,
      4060,
      4800,
      5930,
      6670,
      7630,
      8380
     ]
    },
    {
     "text": "Now. Prices out here move like weather. Sell me the same thing ten times and I'll pay you less each time. Bring me something rare from far away and I'll pay you more.",
     "sound": "afterworld:va.bram.meet_2",
     "ticks": 219,
     "beats": [
      20,
      1200,
      2110,
      3420,
      4330,
      5360,
      6270,
      7580,
      8490,
      9610,
      10520
     ]
    },
    {
     "text": "Go on, sell me something. Anything. Then buy something you need. That's the whole trick of it.",
     "sound": "afterworld:va.bram.meet_3",
     "ticks": 120,
     "beats": [
      20,
      470,
      1080,
      1760,
      2210,
      3020,
      3470,
      3920,
      4720,
      5170,
      5620
     ]
    }
   ],
   "do": [
    "complete:meet_bram",
    "wallet:25"
   ],
   "options": [
    {
     "text": "Show me your wares.",
     "go": "#shop"
    },
    {
     "text": "Thanks, Bram.",
     "go": "#end"
    }
   ]
  },
  "hint_trade": {
   "lines": [
    {
     "text": "Sell me something, then buy something. Open my stall and have a look. Go on.",
