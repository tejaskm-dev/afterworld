  "hunt_done": {
   "lines": [
    {
     "text": "Six of eight. Good. Better than I did, my first winter.",
     "sound": "afterworld:va.torvald.hunt_done_0",
     "ticks": 94,
     "beats": [
      10,
      350,
      720,
      1100,
      1960,
      2400,
      2920,
      3250,
      3580,
      3910,
      4240
     ]
    },
    {
     "text": "Take these claws. They'll let you climb where the rimehorns climb. And the stag, he's taken a liking to you. Whistle, and he'll come.",
     "sound": "afterworld:va.torvald.hunt_done_1",
     "ticks": 169,
     "beats": [
      20,
      650,
      1610,
      2230,
      2860,
      4110,
      4750,
      5630,
      6250,
      7320,
      8040
     ]
    },
    {
     "text": "One more thing. The big tracks, the ones as wide as a cart. Those aren't rimehorn. If you ever follow them, go well armed.",
     "sound": "afterworld:va.torvald.hunt_done_2",
     "ticks": 204,
     "beats": [
      20,
      780,
      1970,
      2980,
      3730,
      5100,
