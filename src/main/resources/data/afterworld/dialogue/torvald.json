    }
   ],
   "options": [
    {
     "text": "Show me the trail again.",
     "go": "#end",
     "do": [
      "minigame:tracking"
     ]
    },
    {
     "text": "Farewell.",
     "go": "#end"
    }
   ]
  },
  "hunt_killed": {
   "lines": [
    {
     "text": "You brought down the alpha? Then you've earned a contest.",
