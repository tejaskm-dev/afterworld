  "wayfarer_parts": {
   "lines": [
    {
     "text": "Look at that! Springs, clockwork, and not a single finger missing. Splendid.",
     "sound": "afterworld:va.odo.wayfarer_parts_0",
     "ticks": 113,
     "cue": "laughs",
     "beats": [
      20,
      470,
      1140,
      1640,
      2160,
      2650,
      3090,
      3530,
      3970,
      4820,
      5270
     ]
    },
    {
     "text": "Now, before I trust her with passengers, someone has to test the wings. Climb the tower, take this practice wing, and fly through every ring before the sand runs out.",
