  "stars_offer": {
   "lines": [
    {
     "text": "There was a constellation here once. The Lost Moth. Its stars fell one by one, and with them went the gazebo's song.",
     "sound": "afterworld:va.selene.stars_offer_0",
     "ticks": 200,
     "beats": [
      30,
      820,
      1600,
      2700,
      3480,
      4550,
      5340,
      6120,
      6910,
      7690,
      8580
     ]
    },
    {
     "text": "The old star chart was torn into three. One piece lies in the crystal observatory in the Shardfields. One at the aurora shrine in the Glimmerfrost. And one in the crater where a star once fell, out on the Ember Steppe.",
     "sound": "afterworld:va.selene.stars_offer_1",
     "ticks": 301,
     "beats": [
      20,
      1220,
      2800,
      4000,
      5190,
      6810,
      8010,
      9550,
      10750,
      11950,
      13320
     ]
    },
    {
     "text": "Bring the pieces to me, and we will put the Moth back in the sky.",
     "sound": "afterworld:va.selene.stars_offer_2",
     "ticks": 107,
     "beats": [
      10,
      430,
      850,
      1260,
      1680,
      2090,
      2510,
      2930,
      3340,
      3760,
      4210
     ]
    }
   ],
   "options": [
    {
     "text": "I'll find them.",
     "go": "#end",
     "do": [
      "side:stars:start"
     ]
    },
    {
     "text": "Not now.",
     "go": "#end"
    }
   ]
  },
  "stars_progress": {
   "lines": [
    {
     "text": "Three pieces. The observatory, the aurora shrine, the crater. The sky can wait. It is very patient.",
     "sound": "afterworld:va.selene.stars_progress_0",
