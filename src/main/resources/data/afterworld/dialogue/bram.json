   ],
   "options": [
    {
     "text": "Show me your wares.",
     "go": "#shop"
    },
    {
     "text": "Farewell.",
     "go": "#end"
    }
   ]
  },
  "meal_offer": {
   "lines": [
    {
     "text": "You know what this camp's missing? A proper meal. Not jerky. Not bread. A stew that remembers its grandmother.",
     "sound": "afterworld:va.bram.meal_offer_0",
     "ticks": 166,
     "beats": [
      20,
      690,
      1350,
      2390,
      3400,
      4060,
      4890,
      5900,
      6560,
      7220,
      7880
     ]
    },
    {
     "text": "Bring me two raw beef, three carrots, two potatoes, and an ember core for the warmth. I'll teach you to cook it yourself.",
     "sound": "afterworld:va.bram.meal_offer_1",
     "ticks": 146,
     "beats": [
