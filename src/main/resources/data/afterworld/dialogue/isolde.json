  "the_light": {
   "lines": [
    {
     "text": "The waystones answer the ones they know. While you're on the road, a pillar of light stands over the place you're bound for.",
     "sound": "afterworld:va.isolde.the_light_0",
     "ticks": 142,
     "beats": [
      20,
      620,
      1220,
      1820,
      2930,
      3530,
      4240,
      4840,
      5450,
      6050,
      6640
     ]
    },
    {
     "text": "Press G to change which place it marks, if you're chasing more than one thing at once.",
     "sound": "afterworld:va.isolde.the_light_1",
     "ticks": 97,
     "beats": [
