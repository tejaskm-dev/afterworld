      20,
      680,
      1770,
      2490,
      3150,
      3950,
      5110,
      5770,
      6560,
      7300,
      8070
     ]
    },
    {
     "text": "Gearhounds carry springs in their bellies, poor things. Clockwork you'll find wherever the King's toys wander.",
     "sound": "afterworld:va.odo.wayfarer_offer_1",
     "ticks": 128,
     "beats": [
