 "nodes": {
  "meet": {
   "lines": [
    {
     "text": "Hush. The moon is listening. I'm Selene. I keep the gazebo, and I count the stars that fall.",
     "sound": "afterworld:va.selene.meet_0",
     "ticks": 172,
     "cue": "whispers",
     "beats": [
      10,
      650,
      1540,
      2780,
      3420,
      4060,
      4700,
      5340,
      5980,
      6620,
      7280
     ]
    },
    {
     "text": "Every night there is one fewer. I think someone is collecting them.",
     "sound": "afterworld:va.selene.meet_1",
     "ticks": 117,
     "beats": [
      10,
      480,
      940,
      1400,
      1860,
