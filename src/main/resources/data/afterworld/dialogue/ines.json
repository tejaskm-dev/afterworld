 "nodes": {
  "meet": {
   "lines": [
    {
     "text": "Peace, traveller. I am Sister Ines, of the Morrow Court. We remember the dead, so that they may rest.",
     "sound": "afterworld:va.ines.meet_0",
     "ticks": 180,
     "beats": [
      10,
      730,
      1450,
      2170,
      2890,
      3610,
      4570,
      5290,
      6010,
      6730,
      7610
     ]
    },
    {
     "text": "The bell of this chapel drowned long ago. Still, some nights, I hear it ring.",
     "sound": "afterworld:va.ines.meet_1",
     "ticks": 153,
     "beats": [
      30,
      650,
      1260,
      1870,
      2480,
      3280,
      3890,
      4500,
      5110,
      5720,
      6400
     ]
    }
   ],
   "options": [
    {
     "text": "Can you tend my wounds?",
     "go": "heal",
     "do": [
      "heal"
     ]
    },
    {
     "text": "Who rings it?",
     "go": "bell_offer",
     "if": [
      "!side:bell:started"
     ]
    },
    {
     "text": "What do you keep here?",
     "go": "#shop"
    },
    {
     "text": "Farewell.",
     "go": "#end"
    }
   ]
  },
