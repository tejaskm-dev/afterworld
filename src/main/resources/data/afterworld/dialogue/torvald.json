  "big": {
   "lines": [
    {
     "text": "Ice and white fur, and horns like a cathedral's ribs. The old songs call it the Rimeback.",
     "sound": "afterworld:va.torvald.big_0",
     "ticks": 161,
     "beats": [
      20,
      630,
      1230,
      2270,
      2880,
      3480,
      4150,
      5540,
      6150,
      6870,
      7540
     ]
    },
    {
     "text": "If you ever see the snow stand up, run. Then run some more.",
     "sound": "afterworld:va.torvald.big_1",
     "ticks": 107,
     "cue": "beat",
     "beats": [
      20,
      370,
      710,
      1050,
      1400,
      1740,
      2700,
      3860,
      4200,
      4540,
      4880
     ]
    }
   ],
   "options": [
    {
     "text": "Can we trade?",
     "go": "#shop"
    },
    {
     "text": "Farewell.",
     "go": "#end"
    }
   ]
  },
  "hunt_offer": {
   "lines": [
    {
     "text": "The rimehorn alpha has been taking the young ones from the valley. I am old, and my knees are older. You are neither.",
     "sound": "afterworld:va.torvald.hunt_offer_0",
     "ticks": 168,
     "beats": [
      30,
      670,
      1310,
      1940,
      2570,
      3820,
      4460,
      5320,
      5950,
      7320,
      7950
     ]
    },
    {
     "text": "Follow its tracks from the lodge. They're deep and wide, and the snow fills them fast. Lose them, and you lose it.",
     "sound": "afterworld:va.torvald.hunt_offer_1",
     "ticks": 158,
     "beats": [
      0,
      670,
      1280,
      2220,
      2890,
      3570,
      4180,
      4780,
      5900,
      6680,
      7410
     ]
    }
   ],
   "options": [
    {
     "text": "I'll hunt it.",
     "go": "#end",
     "do": [
      "side:hunt:start",
      "minigame:tracking"
     ]
    },
    {
     "text": "Not now.",
     "go": "#end"
    }
   ]
  },
  "hunt_progress": {
   "lines": [
    {
     "text": "Its tracks start at the lodge. Watch the snow. The fresh ones still have their edges.",
     "sound": "afterworld:va.torvald.hunt_progress_0",
     "ticks": 111,
     "beats": [
      10,
      430,
      860,
      1280,
