 "nodes": {
  "welcome": {
   "lines": [
    {
     "text": "There you are. I felt the waystone hum the moment you woke.",
     "sound": "afterworld:va.isolde.welcome_0",
     "ticks": 104,
     "cue": "softly",
     "beats": [
      20,
      370,
      710,
      2140,
      2480,
      2840,
      3180,
      3540,
      3980,
      4330,
      4750
     ]
    },
    {
     "text": "Easy, now. Everyone wakes a little lost. The Afterworld is like that. It listens before it speaks.",
     "sound": "afterworld:va.isolde.welcome_1",
     "ticks": 177,
     "beats": [
      20,
      670,
      1500,
      2140,
      2780,
      4380,
      5020,
      5660,
      6960,
      7660,
      8390
     ]
    },
    {
     "text": "I'm Isolde, Warden of this camp. We keep the waystones lit, and we keep travellers like you on your feet.",
     "sound": "afterworld:va.isolde.welcome_2",
     "ticks": 163,
     "beats": [
      20,
      610,
      1440,
      2040,
      3610,
      4200,
      5230,
      5830,
      6410,
      7000,
      7650
     ]
    }
   ],
   "options": [
    {
     "text": "Where am I?",
     "go": "where"
    },
    {
     "text": "What do you mean, it listens?",
     "go": "listens"
    },
    {
     "text": "What should I do first?",
     "go": "first"
    }
   ]
  },
  "where": {
   "lines": [
    {
     "text": "A world still deciding what it wants to be. Old rules, half forgotten, written into stone and storm.",
     "sound": "afterworld:va.isolde.where_0",
     "ticks": 186,
     "beats": [
      30,
      740,
      1450,
      2170,
      4160,
      4860,
      5620,
      6710,
      7410,
      8120,
      8820
     ]
    },
    {
     "text": "We call those rules Edicts. A few folk carry one inside them, the way you do. That's why the world noticed you.",
     "sound": "afterworld:va.isolde.where_1",
     "ticks": 195,
     "beats": [
      20,
      710,
      1570,
      3220,
      3910,
      4610,
      5300,
      6220,
      7900,
      8590,
      9270
     ]
    }
   ],
   "options": [
    {
     "text": "What do you mean, it listens?",
     "go": "listens"
    },
    {
     "text": "What should I do first?",
     "go": "first"
    }
   ]
  },
  "listens": {
   "lines": [
    {
     "text": "Walk far enough and you'll see. Stones that forget to fall. A bell that rings and takes the memory with it. A king who keeps time in a vault.",
     "sound": "afterworld:va.isolde.listens_0",
     "ticks": 223,
     "beats": [
      30,
      850,
      1670,
      3100,
      3930,
      5470,
      6290,
      7150,
      8960,
      9840,
      10700
     ]
    },
    {
     "text": "None of it's cruel, exactly. But it remembers what you do. Every kindness, and every grudge.",
     "sound": "afterworld:va.isolde.listens_1",
     "ticks": 169,
     "beats": [
      20,
      690,
      1360,
      2030,
      2930,
      3600,
      4270,
      5710,
      6730,
      7400,
      8070
     ]
    }
   ],
   "options": [
