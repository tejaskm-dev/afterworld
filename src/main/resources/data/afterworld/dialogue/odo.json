  "wayfarer_offer": {
   "lines": [
    {
     "text": "Here's the trouble. The Wayfarer's rudder springs are shot, and her clock-heart is skipping. I need six gear springs and two clockwork fragments.",
     "sound": "afterworld:va.odo.wayfarer_offer_0",
     "ticks": 171,
