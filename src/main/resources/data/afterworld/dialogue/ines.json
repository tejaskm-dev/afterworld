      5900,
      7340,
      8320,
      9240,
      10240
     ]
    }
   ],
   "options": [
    {
     "text": "I'll find the rope.",
     "go": "#end",
     "do": [
      "side:bell:start"
     ]
    },
    {
     "text": "Not now.",
     "go": "#end"
    }
   ]
  },
  "bell_progress": {
   "lines": [
    {
